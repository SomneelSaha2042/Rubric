# Backend only. Never expose credentials through VITE_* variables.
# Full Chat Completions URL; all three fields are required for assisted drafting.
DRAFTING_URL=
DRAFTING_MODEL=
DRAFTING_API_KEY=

JEV_API_KEY=
JEV_MODEL=jev-1.13.0

# HTTP supports either a third-party endpoint or our own laya-serve deployment.
# Boundless is selected for the pilot. Add its key server-side when wiring the app.
LAYA_BACKEND=http
LAYA_URL=https://api.inference.boundless.network/v1/systemone
LAYA_API_KEY=
LAYA_MODEL=convaiinnovations/laya
LAYA_MAX_LEN=8192

# Optional future in-process backend only; not required for the hosted pilot.
# Explicit multilingual checkpoint; no automatic checkpoint routing.
LAYA_CHECKPOINT=convaiinnovations/laya-multilingual
LAYA_DEVICE=cpu
HF_HOME=.cache/huggingface

# Relative to the repository root; approved rubric versions only.
SQLITE_PATH=data/rubric.sqlite3
